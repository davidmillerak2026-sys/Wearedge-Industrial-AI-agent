LLAMA_BASE_URL=http://127.0.0.1:8080
LLAMA_MODEL=gemma4
DEMO_TOKEN=change-this-token-before-demo
WEAREDGE_MAX_IMAGE_MB=4
WEAREDGE_ENABLE_THINKING=true
WEAREDGE_MODEL_VARIANT=E2B
WEAREDGE_MAX_TOKENS=260
WEAREDGE_TEMPERATURE=0.2
WEAREDGE_CONTRACT_MIN_WORDS=16
WEAREDGE_CONTRACT_REPAIR_ENABLED=true
# llama.cpp runtime tuning for constrained Jetson memory.
LLAMA_CONTEXT=2048
LLAMA_BATCH_SIZE=512
LLAMA_UBATCH_SIZE=512
LLAMA_NGL=99
# Visual Token Dynamic Allocation module: jetson/modality_pipeline.py.
LLAMA_IMAGE_MIN_TOKENS=70
LLAMA_IMAGE_MAX_TOKENS=70
# Audio Fusion module placeholder. Current llama.cpp path is image+text; use vLLM/NIM for native E2B/E4B audio.
# WEAREDGE_AUDIO_FUSION_RUNTIME=vllm
# Optional: keep uploaded images for debugging. Leave unset for privacy-first demos.
# WEAREDGE_UPLOAD_DIR=/mnt/nvme/wearedge/uploads
# Optional: append privacy-preserving inference metadata and structured results.
# WEAREDGE_EVENT_LOG=/mnt/nvme/wearedge/events/inference.jsonl
